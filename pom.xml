<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.papenhagen</groupId>
    <artifactId>hierarchical-splitter</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Hierarchical Splitter</name>
    <description>Spring Boot starter for hierarchical text splitting for RAG applications</description>

    <modules>
        <module>hierarchical-splitter-core</module>
        <module>hierarchical-splitter-autoconfigure</module>
        <module>hierarchical-splitter-starter</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.0.3</spring-boot.version>
        <spring-ai.version>2.0.0-M2</spring-ai.version>
        <sat.version>0.18.0</sat.version>
    </properties>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Jens Papenhagen</name>
            <email>jens.papenhagen@web.de</email>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/papenhagen/hierarchical-splitter-autoconfigure-starter</url>
        <connection>scm:git:git@github.com:papenhagen/hierarchical-splitter-autoconfigure-starter.git</connection>
        <developerConnection>scm:git:git@github.com:papenhagen/hierarchical-splitter-autoconfigure-starter.git</developerConnection>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2</url>
        </repository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.papenhagen</groupId>
                <artifactId>hierarchical-splitter-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.papenhagen</groupId>
                <artifactId>hierarchical-splitter-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.openhab.tools.sat</groupId>
                    <artifactId>sat-plugin</artifactId>
                    <version>${sat.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.14</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.plugins</groupId>
                    <artifactId>nexus-staging-maven-plugin</artifactId>
                    <version>1.7.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.openhab.tools.sat</groupId>
                <artifactId>sat-plugin</artifactId>
                <configuration>
                    <pmdRuleset>pmd-rules.xml</pmdRuleset>
                    <checkstyleRuleset>checkstyle.xml</checkstyleRuleset>
                    <spotbugsExclude>spotbugs-exclude.xml</spotbugsExclude>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>check</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.openhab.tools.sat</groupId>
                            <artifactId>sat-plugin</artifactId>
                            <version>${sat.version}</version>
                            <executions>
                                <execution>
                                    <phase>verify</phase>
                                    <goals>
                                        <goal>checkstyle</goal>
                                        <goal>pmd</goal>
                                        <goal>spotbugs</goal>
                                        <goal>report</goal>
                                    </goals>
                                </execution>
                            </executions>
                            <configuration>
                                <pmdRuleset>pmd-rules.xml</pmdRuleset>
                                <checkstyleRuleset>checkstyle.xml</checkstyleRuleset>
                                <spotbugsExclude>spotbugs-exclude.xml</spotbugsExclude>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
